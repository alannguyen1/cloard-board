#!/usr/bin/env zsh
# cloard-board: tmux kanban dashboard for Claude Code worktree sessions
# Usage: cloard-board <command> [args]
set -euo pipefail
setopt KSH_ARRAYS  # Use 0-based array indexing (C-style, consistent with loop conventions)
# Capture stable script path at startup (realpath "$0" inside functions resolves incorrectly in zsh)
SCRIPT_PATH=$(realpath "$0" 2>/dev/null || readlink -f "$0" 2>/dev/null || echo "$0")

# ── Constants ──────────────────────────────────────────────────────────────────
readonly VERSION="0.1.0"
readonly TMUX_SOCKET="cloard-board"
readonly STATE_DIR=".cloard-board"
readonly STATE_FILE="${STATE_DIR}/tasks.json"
readonly INIT_SCRIPT="${STATE_DIR}/init.sh"
readonly DASH_REFRESH="${CLOARD_REFRESH:-1}"  # seconds between dashboard refreshes

# ── Colours (ANSI) ────────────────────────────────────────────────────────────
readonly C_RESET=$'\e[0m'
readonly C_BOLD=$'\e[1m'
readonly C_DIM=$'\e[2m'
readonly C_RED=$'\e[31m'
readonly C_GREEN=$'\e[32m'
readonly C_YELLOW=$'\e[33m'
readonly C_BLUE=$'\e[34m'
readonly C_MAGENTA=$'\e[35m'
readonly C_CYAN=$'\e[36m'
readonly C_WHITE=$'\e[37m'
readonly C_BG_BLUE=$'\e[44m'
readonly C_BG_DEFAULT=$'\e[49m'

# ── Helpers ────────────────────────────────────────────────────────────────────
die()  { echo "${C_RED}error:${C_RESET} $*" >&2; exit 1; }
info() { echo "${C_CYAN}▸${C_RESET} $*"; }
ok()   { echo "${C_GREEN}✓${C_RESET} $*"; }
warn() { echo "${C_YELLOW}!${C_RESET} $*" >&2; }

require_cmd() {
  command -v "$1" &>/dev/null || die "'$1' is required but not found"
}

require_init() {
  [[ -f "$STATE_FILE" ]] || die "not initialised; run 'cloard-board init' first"
}

now_iso() { date -u +"%Y-%m-%dT%H:%M:%SZ"; }

# ── JSON helpers (jq wrappers) ─────────────────────────────────────────────────
read_tasks() { jq -r '.tasks' "$STATE_FILE"; }

read_task() {
  local id="$1"
  jq -r --arg id "$id" '.tasks[] | select(.id == $id)' "$STATE_FILE"
}

task_exists() {
  local id="$1"
  [[ "$(jq -r --arg id "$id" '[.tasks[] | select(.id == $id)] | length' "$STATE_FILE")" -gt 0 ]]
}

task_status() {
  local id="$1"
  jq -r --arg id "$id" '.tasks[] | select(.id == $id) | .status' "$STATE_FILE"
}

update_task_field() {
  local id="$1" field="$2" value="$3"
  local tmp
  tmp=$(mktemp "${STATE_DIR}/.tasks.XXXXXX")
  jq --arg id "$id" --arg f "$field" --arg v "$value" \
    '(.tasks[] | select(.id == $id))[$f] = $v' "$STATE_FILE" > "$tmp" \
    && mv "$tmp" "$STATE_FILE"
}

update_task_field_raw() {
  # For non-string values (null, numbers)
  local id="$1" field="$2" value="$3"
  local tmp
  tmp=$(mktemp "${STATE_DIR}/.tasks.XXXXXX")
  jq --arg id "$id" --arg f "$field" --argjson v "$value" \
    '(.tasks[] | select(.id == $id))[$f] = $v' "$STATE_FILE" > "$tmp" \
    && mv "$tmp" "$STATE_FILE"
}

# ── tmux helpers ───────────────────────────────────────────────────────────────
tmux_cmd() { tmux -L "$TMUX_SOCKET" "$@"; }

tmux_session_exists() {
  tmux_cmd has-session -t "board" 2>/dev/null
}

ensure_tmux_session() {
  if ! tmux_session_exists; then
    tmux_cmd new-session -d -s "board" -n "dashboard" -x 200 -y 50 -c "$PWD"
    tmux_cmd bind-key -T prefix b select-window -t "board:dashboard"
    pin_dashboard_to_zero
    # The dashboard window will be started by 'dash' command
  fi
}

tmux_window_exists() {
  local name="$1"
  tmux_cmd list-windows -t "board" -F '#{window_name}' 2>/dev/null | grep -qx "$name"
}

tmux_create_window() {
  local name="$1"
  shift
  tmux_cmd new-window -t "board" -n "$name" "$@"
  pin_dashboard_to_zero
}

tmux_kill_window() {
  local name="$1"
  if tmux_window_exists "$name"; then
    tmux_cmd kill-window -t "board:$name" 2>/dev/null || true
  fi
}

tmux_select_window() {
  local name="$1"
  tmux_cmd select-window -t "board:$name" 2>/dev/null
}

pin_dashboard_to_zero() {
  local dash_idx
  dash_idx=$(tmux_cmd list-windows -t "board" -F '#{window_name} #{window_index}' 2>/dev/null \
    | awk '$1 == "dashboard" { print $2 }')
  if [[ -n "$dash_idx" && "$dash_idx" != "0" ]]; then
    tmux_cmd swap-window -s "board:dashboard" -t "board:0" 2>/dev/null || true
  fi
}

# ── Worktree helpers ───────────────────────────────────────────────────────────
find_worktree_path() {
  # Discover worktree path for a given branch/name from git worktree list
  local id="$1"
  local branch="worktree-${id}"
  git worktree list --porcelain 2>/dev/null | awk -v branch="refs/heads/$branch" '
    /^worktree / { path = substr($0, 10) }
    /^branch / { if ($2 == branch) print path }
  '
}

# ── Commands ───────────────────────────────────────────────────────────────────

cmd_help() {
  cat <<EOF
${C_BOLD}cloard-board${C_RESET} v${VERSION}
tmux kanban dashboard for Claude Code worktree sessions

${C_BOLD}USAGE${C_RESET}
  cloard-board <command> [args]

${C_BOLD}COMMANDS${C_RESET}
  init                        Initialise .cloard-board/ in current repo
  add <id> --title "..."      Add a task (status: pending)
                              Options: --no-worktree (skip branch isolation)
  start <id> [prompt]         Start Claude in a worktree (status: active)
  pause <id>                  Pause a task (kill window, keep worktree)
  go <id>                     Switch to a task's tmux window
  dash                        Open the interactive kanban dashboard
  attach                      Attach to the cloard-board tmux session
  review <id>                 Push branch, create PR (status: review)
  done <id>                   Clean up worktree and window (status: done)
  resume <id>                 Reopen a task with claude --continue
  list                        Print all tasks as a table
  rm <id>                     Remove a task entirely
  advance <id>                Move task to next status
  status <id>                 Show task and Claude status
  signal <id> <status>        Set Claude status (working|waiting|clear)
  doctor                      Check for orphaned worktrees/windows

${C_BOLD}OPTIONS${C_RESET}
  --help, -h                  Show this help
  --version, -v               Show version

${C_BOLD}EXAMPLES${C_RESET}
