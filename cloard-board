# ── Repo helpers ──────────────────────────────────────────────────────────────
repo_exists() {
  local name="$1"
  [[ "$(jq -r --arg n "$name" '[.repos[] | select(.name == $n)] | length' "$GLOBAL_STATE")" -gt 0 ]]
}

repo_path() {
  local name="$1"
  jq -r --arg n "$name" '.repos[] | select(.name == $n) | .path' "$GLOBAL_STATE"
}

repo_type() {
  local name="$1"
  jq -r --arg n "$name" '.repos[] | select(.name == $n) | .type // "git"' "$GLOBAL_STATE"
}

repo_base_branch() {
