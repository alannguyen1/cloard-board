}

cmd_version() { echo "cloard-board v${VERSION}"; }

cmd_init() {
  if [[ -f "$STATE_FILE" ]]; then
    info "already initialised at ${STATE_DIR}/"
  else
    # Detect project name from git toplevel or current directory
    local project
    local _git_root
    _git_root=$(git rev-parse --show-toplevel 2>/dev/null || echo "")
    if [[ -n "$_git_root" ]]; then
      project=$(basename "$_git_root")
    else
      project=$(basename "$PWD")
    fi

    # Detect default branch
    local base_branch
    base_branch=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@refs/remotes/origin/@@' || echo "main")

    mkdir -p "$STATE_DIR"

    # Use jq to produce valid JSON (avoids injection from special chars in project/branch names)
    jq -n --arg p "$project" --arg b "$base_branch" \
      '{version: 1, project: $p, base_branch: $b, tasks: []}' > "$STATE_FILE"

    # Add to .gitignore if not already there
    if [[ -f .gitignore ]]; then
      if ! grep -qx '.cloard-board/' .gitignore 2>/dev/null; then
        echo '.cloard-board/' >> .gitignore
        info "added .cloard-board/ to .gitignore"
      fi
    else
      echo '.cloard-board/' > .gitignore
      info "created .gitignore with .cloard-board/"
    fi

    ok "initialised ${STATE_DIR}/ for project '${project}' (base: ${base_branch})"
  fi

  # Set up Claude Code hooks (idempotent; runs on both init and re-init)
  mkdir -p "${STATE_DIR}/hooks"

  cat > "${STATE_DIR}/hooks/on-stop.sh" <<'HOOK'
#!/usr/bin/env bash
# cloard-board hook: set task status to "waiting" when Claude stops
[[ -n "${CLOARD_TASK_ID:-}" ]] || exit 0
[[ -n "${CLOARD_BOARD_DIR:-}" ]] || exit 0
(cd "$CLOARD_BOARD_DIR" && cloard-board signal "$CLOARD_TASK_ID" waiting) &>/dev/null &
HOOK
  chmod +x "${STATE_DIR}/hooks/on-stop.sh"

  cat > "${STATE_DIR}/hooks/on-prompt.sh" <<'HOOK'
#!/usr/bin/env bash
# cloard-board hook: set task status to "working" when user submits a prompt
[[ -n "${CLOARD_TASK_ID:-}" ]] || exit 0
[[ -n "${CLOARD_BOARD_DIR:-}" ]] || exit 0
(cd "$CLOARD_BOARD_DIR" && cloard-board signal "$CLOARD_TASK_ID" working) &>/dev/null &
HOOK
  chmod +x "${STATE_DIR}/hooks/on-prompt.sh"

  # Register hooks in .claude/settings.json (merge, don't overwrite)
  mkdir -p .claude
  local settings_file=".claude/settings.json"
  local new_hooks
  new_hooks=$(jq -n '{
    "Stop": [{"hooks": [{"type": "command", "command": ".cloard-board/hooks/on-stop.sh"}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": ".cloard-board/hooks/on-prompt.sh"}]}]
  }')

  if [[ -f "$settings_file" ]]; then
    local tmp_settings
    tmp_settings=$(mktemp)
    # Merge hooks: remove any existing cloard-board entries, then append ours
    # This preserves other hooks for the same event types and is idempotent
    jq --argjson new_hooks "$new_hooks" '
      .hooks = ((.hooks // {}) |
        reduce ($new_hooks | to_entries[]) as $entry (.;
          .[$entry.key] = (
            [(.[$entry.key] // [])[] |
              select(.hooks | all(.command | test("cloard-board") | not))
            ] + $entry.value
          )
        )
      )
    ' "$settings_file" > "$tmp_settings" \
      && mv "$tmp_settings" "$settings_file"
  else
    jq -n --argjson hooks "$new_hooks" '{hooks: $hooks}' > "$settings_file"
  fi

  ok "hooks configured in .claude/settings.json"
}

cmd_add() {
  require_init
  local id="" title="" worktree_mode="worktree"

  # Parse args
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --title|-t) [[ $# -gt 1 ]] || die "--title requires a value"; title="$2"; shift 2 ;;
      --title=*) title="${1#*=}"; shift ;;
      --no-worktree) worktree_mode="none"; shift ;;
      -*) die "unknown flag: $1" ;;
      *)
        if [[ -z "$id" ]]; then
          id="$1"; shift
        else
          die "unexpected argument: $1"
        fi
        ;;
    esac
  done

  [[ -n "$id" ]] || die "usage: cloard-board add <id> --title \"...\""
  [[ -n "$title" ]] || die "missing --title"

  # Validate id (alphanumeric, hyphens, underscores)
  [[ "$id" =~ ^[a-zA-Z0-9_-]+$ ]] || die "id must be alphanumeric with hyphens/underscores"

  if task_exists "$id"; then
    die "task '$id' already exists"
  fi

  local tmp
  tmp=$(mktemp "${STATE_DIR}/.tasks.XXXXXX")
  local now=$(now_iso)
  jq --arg id "$id" --arg title "$title" --arg now "$now" --arg wm "$worktree_mode" \
    '.tasks += [{
      id: $id,
      title: $title,
      status: "pending",
      branch: (if $wm == "none" then null else ("worktree-" + $id) end),
      worktree: null,
      worktree_mode: $wm,
      pr_number: null,
      pr_url: null,
      created_at: $now,
      started_at: null,
      completed_at: null,
      claude_status: null
    }]' "$STATE_FILE" > "$tmp" && mv "$tmp" "$STATE_FILE"

  ok "added task '${id}': ${title}"
}

cmd_list() {
  require_init
  local count
  count=$(jq '.tasks | length' "$STATE_FILE")

  if [[ "$count" -eq 0 ]]; then
    info "no tasks yet; run 'cloard-board add <id> --title \"...\"' to create one"
    return 0
  fi

  # Print table header
  printf "\n${C_BOLD}%-20s %-15s %-40s %-12s %-10s${C_RESET}\n" "ID" "STATUS" "TITLE" "CLAUDE" "PR"
  printf "%-20s %-15s %-40s %-12s %-10s\n" "$(printf '%0.s─' {1..20})" "$(printf '%0.s─' {1..15})" "$(printf '%0.s─' {1..40})" "$(printf '%0.s─' {1..12})" "$(printf '%0.s─' {1..10})"

  jq -r '.tasks[] | [.id, .status, .title, (.claude_status // ""), (.pr_url // "")] | @tsv' "$STATE_FILE" | while IFS=$'\t' read -r t_id t_status t_title t_claude t_pr; do
    local color="$C_RESET"
    case "$t_status" in
      pending)      color="$C_DIM" ;;
      paused)       color="$C_CYAN" ;;
      active)       color="$C_GREEN" ;;
      needs_review) color="$C_YELLOW" ;;
      review)       color="$C_MAGENTA" ;;
      done)         color="$C_DIM" ;;
    esac
    local pr_display=""
    if [[ -n "$t_pr" ]]; then
      pr_display=$(echo "$t_pr" | grep -oE '#[0-9]+' || echo "$t_pr")
    fi
    local claude_display=""
    [[ "$t_claude" == "working" ]] && claude_display="● working"
    [[ "$t_claude" == "waiting" ]] && claude_display="○ waiting"
    printf "${color}%-20s %-15s %-40s %-12s %-10s${C_RESET}\n" "$t_id" "$t_status" "${t_title:0:40}" "$claude_display" "$pr_display"
  done
  echo
}

cmd_start() {
  require_init
  require_cmd claude

  local id="${1:-}"
  [[ -n "$id" ]] || die "usage: cloard-board start <id> [prompt]"
  shift
  local prompt="${*:-}"

  task_exists "$id" || die "task '$id' not found; run 'cloard-board add' first"

  local tsk_status
  tsk_status=$(task_status "$id")
  [[ "$tsk_status" == "pending" ]] || die "task '$id' is '${tsk_status}', not 'pending'"

  ensure_tmux_session

  if tmux_window_exists "$id"; then
    warn "tmux window '$id' already exists; switching to it"
    tmux_select_window "$id"
  else
    # Build the claude command (--dangerously-skip-permissions for autonomous parallel agent work)
    local wt_mode
    wt_mode=$(jq -r --arg id "$id" '.tasks[] | select(.id == $id) | .worktree_mode // "worktree"' "$STATE_FILE")
    local claude_cmd
    if [[ "$wt_mode" == "none" ]]; then
      claude_cmd="claude --dangerously-skip-permissions"
    else
      claude_cmd="claude --worktree ${id} --dangerously-skip-permissions"
    fi
    if [[ -n "$prompt" ]]; then
      # Escape single quotes in prompt for shell wrapping
      local escaped_prompt="${prompt//\'/\'\\\'\'}"
      claude_cmd="${claude_cmd} '${escaped_prompt}'"
    fi

    local safe_pwd
    safe_pwd=${(q)${PWD}}
    tmux_create_window "$id" "zsh" "-c" "export CLOARD_TASK_ID=${id} CLOARD_BOARD_DIR=${safe_pwd} && cd ${safe_pwd} && ${claude_cmd}; zsh; tmux -L cloard-board select-window -t board:dashboard 2>/dev/null"
    if [[ "$wt_mode" == "none" ]]; then
      info "created tmux window '${id}' with claude (no worktree)"
    else
      info "created tmux window '${id}' with claude --worktree ${id}"
    fi
  fi

  # Update state
  update_task_field "$id" "status" "active"
  update_task_field "$id" "started_at" "$(now_iso)"

  # Try to discover worktree path (may not exist yet if claude hasn't created it)
  local wt_path
  wt_path=$(find_worktree_path "$id")
  if [[ -n "$wt_path" ]]; then
    update_task_field "$id" "worktree" "$wt_path"
  fi

  ok "started task '${id}'"

  # Attach if not already in tmux
  if [[ -z "${TMUX:-}" ]]; then
    tmux_cmd attach -t "board:${id}"
  else
    tmux_select_window "$id"
  fi
}

cmd_go() {
  require_init
  local id="${1:-}"
  [[ -n "$id" ]] || die "usage: cloard-board go <id>"
  task_exists "$id" || die "task '$id' not found"

  ensure_tmux_session

  if ! tmux_window_exists "$id"; then
    die "no tmux window for task '${id}'; try 'cloard-board start' or 'cloard-board resume'"
  fi

  if [[ -z "${TMUX:-}" ]]; then
    tmux_cmd attach -t "board:${id}"
  else
    tmux_select_window "$id"
  fi
}

cmd_attach() {
  if ! tmux_session_exists; then
    die "no cloard-board tmux session; run 'cloard-board start' or 'cloard-board dash' first"
  fi
  if [[ -z "${TMUX:-}" ]]; then
    tmux_cmd attach -t "board"
  else
    warn "already inside tmux; use 'cloard-board go <id>' or 'cloard-board dash'"
  fi
}

cmd_advance() {
  require_init
  local id="${1:-}"
  [[ -n "$id" ]] || die "usage: cloard-board advance <id>"
  task_exists "$id" || die "task '$id' not found"

  local tsk_status
  tsk_status=$(task_status "$id")

  case "$tsk_status" in
    pending)
      info "advancing '${id}': pending -> active"
      cmd_start "$id"
      ;;
    paused)
      info "advancing '${id}': paused -> active (resuming)"
      cmd_resume "$id"
      ;;
    active)
      update_task_field "$id" "status" "needs_review"
      update_task_field_raw "$id" "claude_status" "null"
      ok "advanced '${id}': active -> needs_review"
      ;;
    needs_review)
      info "advancing '${id}': needs_review -> review (pushing and creating PR)"
      cmd_review "$id"
      ;;
    review)
      info "advancing '${id}': review -> done"
      cmd_done "$id"
      ;;
    done)
      warn "task '${id}' is already done"
      ;;
  esac
}

cmd_review() {
  require_init
  require_cmd gh
  local id="${1:-}"
  [[ -n "$id" ]] || die "usage: cloard-board review <id>"
  task_exists "$id" || die "task '$id' not found"

  local tsk_status
  tsk_status=$(task_status "$id")
  [[ "$tsk_status" == "needs_review" || "$tsk_status" == "active" ]] || die "task '$id' is '${tsk_status}'; must be 'needs_review' or 'active' to review"

  local wt_mode
  wt_mode=$(jq -r --arg id "$id" '.tasks[] | select(.id == $id) | .worktree_mode // "worktree"' "$STATE_FILE")

  local work_dir branch
  if [[ "$wt_mode" == "none" ]]; then
    work_dir="$PWD"
    branch=$(git rev-parse --abbrev-ref HEAD)
  else
    work_dir=$(find_worktree_path "$id")
    if [[ -z "$work_dir" ]]; then
      die "could not find worktree for task '${id}'"
    fi
    branch="worktree-${id}"
  fi

  local base_branch
  base_branch=$(jq -r '.base_branch' "$STATE_FILE")
  local title
  title=$(jq -r --arg id "$id" '.tasks[] | select(.id == $id) | .title' "$STATE_FILE")

  info "pushing branch '${branch}'..."
  (cd "$work_dir" && git push -u origin "$branch") || die "git push failed"

  # Check for existing PR to avoid duplicate creation
  local pr_url
  pr_url=$(cd "$work_dir" && gh pr view --json url -q '.url' 2>/dev/null || true)

  if [[ -n "$pr_url" ]]; then
    warn "PR already exists: ${pr_url}"
  else
    info "creating PR..."
    pr_url=$(cd "$work_dir" && gh pr create \
      --base "$base_branch" \
      --head "$branch" \
      --title "$title" \
      --body "Task: \`${id}\`

Created by cloard-board." 2>/dev/null) || die "gh pr create failed"
  fi

  # Fetch PR number via structured output (avoids parsing text)
  local pr_number
  pr_number=$(cd "$work_dir" && gh pr view --json number -q '.number' 2>/dev/null || true)

  update_task_field "$id" "status" "review"
  update_task_field_raw "$id" "claude_status" "null"
  update_task_field "$id" "pr_url" "$pr_url"
  if [[ -n "$pr_number" ]]; then
    update_task_field_raw "$id" "pr_number" "$pr_number"
  fi

  ok "PR: ${pr_url}"
  ok "task '${id}' is now in review"
}

cmd_done() {
  require_init
  local id="${1:-}"
  [[ -n "$id" ]] || die "usage: cloard-board done <id>"
  task_exists "$id" || die "task '$id' not found"

  # Kill tmux window
  tmux_kill_window "$id"

  local wt_mode
  wt_mode=$(jq -r --arg id "$id" '.tasks[] | select(.id == $id) | .worktree_mode // "worktree"' "$STATE_FILE")

  if [[ "$wt_mode" != "none" ]]; then
    # Remove worktree
    local wt_path
    wt_path=$(find_worktree_path "$id")
    if [[ -n "$wt_path" ]]; then
      info "removing worktree at ${wt_path}"
      git worktree remove "$wt_path" --force 2>/dev/null || warn "could not remove worktree (may need manual cleanup)"
    fi

    # Delete local branch
    local branch="worktree-${id}"
    git branch -D "$branch" 2>/dev/null || true
  fi

  update_task_field "$id" "status" "done"
  update_task_field "$id" "completed_at" "$(now_iso)"
  update_task_field_raw "$id" "claude_status" "null"

  ok "task '${id}' marked done; window and worktree cleaned up"
}

cmd_pause() {
  require_init
  local id="${1:-}"
  [[ -n "$id" ]] || die "usage: cloard-board pause <id>"
  task_exists "$id" || die "task '$id' not found"

  local tsk_status
  tsk_status=$(task_status "$id")
  [[ "$tsk_status" == "active" || "$tsk_status" == "needs_review" ]] || die "task '$id' is '${tsk_status}'; must be 'active' or 'needs_review' to pause"

  # Kill tmux window (keeps worktree and branch intact)
  tmux_kill_window "$id"

  update_task_field "$id" "status" "paused"
  update_task_field_raw "$id" "claude_status" "null"

  ok "paused task '${id}'; worktree and branch preserved"
}

cmd_resume() {
  require_init
  require_cmd claude

  local id="${1:-}"
  [[ -n "$id" ]] || die "usage: cloard-board resume <id>"
  task_exists "$id" || die "task '$id' not found"

  local tsk_status
  tsk_status=$(task_status "$id")
  [[ "$tsk_status" != "done" ]] || die "task '$id' is done; nothing to resume"

  local wt_mode
  wt_mode=$(jq -r --arg id "$id" '.tasks[] | select(.id == $id) | .worktree_mode // "worktree"' "$STATE_FILE")

  ensure_tmux_session

  if tmux_window_exists "$id"; then
    info "window '${id}' already exists; switching to it"
  else
    if [[ "$wt_mode" == "none" ]]; then
      local safe_pwd
      safe_pwd=${(q)${PWD}}
      tmux_create_window "$id" "zsh" "-c" "export CLOARD_TASK_ID=${id} CLOARD_BOARD_DIR=${safe_pwd} && cd ${safe_pwd} && claude --continue --dangerously-skip-permissions; zsh; tmux -L cloard-board select-window -t board:dashboard 2>/dev/null"
      info "created tmux window '${id}' with claude --continue (no worktree)"
    else
      local wt_path
      wt_path=$(find_worktree_path "$id")
      if [[ -z "$wt_path" ]]; then
        die "no worktree found for '${id}'; use 'cloard-board start' instead"
      fi
      local safe_wt_path
      safe_wt_path=${(q)${wt_path}}
      local safe_board_dir=${(q)${PWD}}
      tmux_create_window "$id" "zsh" "-c" "export CLOARD_TASK_ID=${id} CLOARD_BOARD_DIR=${safe_board_dir} && cd ${safe_wt_path} && claude --continue --dangerously-skip-permissions; zsh; tmux -L cloard-board select-window -t board:dashboard 2>/dev/null"
      info "created tmux window '${id}' with claude --continue"
    fi
  fi

  # Ensure status is active
  if [[ "$tsk_status" != "active" ]]; then
    update_task_field "$id" "status" "active"
  fi

  if [[ -z "${TMUX:-}" ]]; then
    tmux_cmd attach -t "board:${id}"
  else
    tmux_select_window "$id"
  fi
}

cmd_rm() {
  require_init
  local id="${1:-}"
  [[ -n "$id" ]] || die "usage: cloard-board rm <id>"
  task_exists "$id" || die "task '$id' not found"

  local tsk_status
  tsk_status=$(task_status "$id")

  # Clean up resources for any non-done status (review tasks still have windows/worktrees/branches)
  if [[ "$tsk_status" != "done" ]]; then
    tmux_kill_window "$id"
    local wt_mode
    wt_mode=$(jq -r --arg id "$id" '.tasks[] | select(.id == $id) | .worktree_mode // "worktree"' "$STATE_FILE")
    if [[ "$wt_mode" != "none" ]]; then
      local wt_path
      wt_path=$(find_worktree_path "$id")
      if [[ -n "$wt_path" ]]; then
        git worktree remove "$wt_path" --force 2>/dev/null || true
      fi
      git branch -D "worktree-${id}" 2>/dev/null || true
    fi
  fi

  # Remove from JSON
  local tmp
  tmp=$(mktemp "${STATE_DIR}/.tasks.XXXXXX")
  jq --arg id "$id" '.tasks = [.tasks[] | select(.id != $id)]' "$STATE_FILE" > "$tmp" \
    && mv "$tmp" "$STATE_FILE"

  ok "removed task '${id}'"
}

cmd_status() {
  require_init
  local id="${1:-}"
  [[ -n "$id" ]] || die "usage: cloard-board status <id>"
  task_exists "$id" || die "task '$id' not found"

  local tsk_status claude_status title
  tsk_status=$(task_status "$id")
  claude_status=$(task_field "$id" "claude_status")
  title=$(task_field "$id" "title")

  echo "${C_BOLD}${id}${C_RESET}: ${title}"
  echo "  task:   ${tsk_status}"
  if [[ "$claude_status" == "working" ]]; then
    echo "  claude: ${C_GREEN}● working${C_RESET}"
  elif [[ "$claude_status" == "waiting" ]]; then
    echo "  claude: ${C_YELLOW}○ waiting${C_RESET}"
  else
    echo "  claude: ${C_DIM}no status${C_RESET}"
  fi
}

cmd_signal() {
  require_init
  local id="${1:-}"
  local signal="${2:-}"

  [[ -n "$id" ]] || { warn "usage: cloard-board signal <id> <working|waiting|clear>"; return 1; }
  [[ -n "$signal" ]] || { warn "usage: cloard-board signal <id> <working|waiting|clear>"; return 1; }

  if ! task_exists "$id"; then
    warn "task '$id' not found (may have been removed)"
    return 0
  fi

  case "$signal" in
    working|waiting)
      # Only update if task is still active (prevents race with pause/done/review)
      local tsk_status
      tsk_status=$(task_status "$id")
      if [[ "$tsk_status" == "active" ]]; then
        update_task_field "$id" "claude_status" "$signal"
      fi
      ;;
    clear)
      update_task_field_raw "$id" "claude_status" "null"
      ;;
    *)
      warn "unknown signal: ${signal}; expected working, waiting, or clear"
      return 1
      ;;
  esac
}

cmd_doctor() {
  require_init
  local issues=0

  info "checking cloard-board health..."

  # Check for worktrees that have no matching task
  while IFS= read -r line; do
    if [[ "$line" =~ ^worktree\ (.+)$ ]]; then
      local wt_path="${match[0]}"
    elif [[ "$line" =~ ^branch\ refs/heads/worktree-(.+)$ ]]; then
      local wt_id="${match[0]}"
      if ! task_exists "$wt_id"; then
        warn "orphaned worktree: ${wt_path} (branch worktree-${wt_id}, no matching task)"
        issues=$((issues+1))
      fi
    fi
  done < <(git worktree list --porcelain 2>/dev/null)

  # Check for tasks with windows that don't exist
  while read -r tid; do
    [[ -z "$tid" ]] && continue
    if ! tmux_window_exists "$tid" 2>/dev/null; then
      warn "task '${tid}' is active but has no tmux window"
      issues=$((issues+1))
    fi
  done < <(jq -r '.tasks[] | select(.status == "active") | .id' "$STATE_FILE")

  # Check for tmux windows with no matching task
  if tmux_session_exists; then
    while read -r wname; do
      [[ -z "$wname" || "$wname" == "dashboard" ]] && continue
      if ! task_exists "$wname"; then
        warn "orphaned tmux window: '${wname}' (no matching task)"
        issues=$((issues+1))
      fi
    done < <(tmux_cmd list-windows -t "board" -F '#{window_name}' 2>/dev/null)
  fi

  if [[ "$issues" -eq 0 ]]; then
    ok "all clear; no issues found"
  else
    warn "${issues} issue(s) found"
  fi
}

# ── Dashboard TUI ──────────────────────────────────────────────────────────────

# Column names and matching statuses
readonly -a COL_NAMES=("Pending" "Active" "Needs Review" "In PR" "Done")
readonly -a COL_STATUSES=("pending" "active" "needs_review" "review" "done")

# Column colours
col_color() {
  case "$1" in
    0) echo "$C_DIM" ;;       # pending
    1) echo "$C_GREEN" ;;     # active
    2) echo "$C_YELLOW" ;;    # needs_review
    3) echo "$C_MAGENTA" ;;   # review
    4) echo "$C_DIM" ;;       # done
  esac
}

# Get task IDs for a given status
tasks_for_status() {
  local st="$1"
  jq -r --arg s "$st" '[.tasks[] | select(.status == $s) | .id] | .[]' "$STATE_FILE" 2>/dev/null
}

# Get task IDs for a dashboard column (column 0 includes both pending and paused)
tasks_for_column() {
  local col="$1"
  if [[ $col -eq 0 ]]; then
    jq -r '[.tasks[] | select(.status == "pending" or .status == "paused") | .id] | .[]' "$STATE_FILE" 2>/dev/null
  else
    tasks_for_status "${COL_STATUSES[$col]}"
  fi
}

# Get task field
task_field() {
  local id="$1" field="$2"
  jq -r --arg id "$id" --arg f "$field" '.tasks[] | select(.id == $id) | .[$f] // ""' "$STATE_FILE" 2>/dev/null
}

# Truncate string to width
trunc() {
  local str="$1" max="$2"
  if [[ ${#str} -gt $max ]]; then
    echo "${str:0:$((max-1))}…"
  else
    echo "$str"
  fi
}

# Draw a horizontal line
hline() {
  local width="$1" char="${2:-─}"
  printf '%*s' "$width" '' | tr ' ' "$char"
}

# ── Dashboard snapshot helpers (single-jq optimization) ────────────────────────

# Snapshot all tasks into associative + indexed arrays (1 jq call per frame)
# Relies on caller declaring: typeset -A _task_status _task_title _task_pr _task_claude _task_wtmode
#   local -a _col0_ids .. _col4_ids; local _project_name _task_count
_snapshot_tasks() {
  _task_status=()
  _task_title=()
  _task_pr=()
  _task_claude=()
  _task_wtmode=()
  _col0_ids=()
  _col1_ids=()
  _col2_ids=()
  _col3_ids=()
  _col4_ids=()
  _project_name=""
  _task_count=0

  local _snap
  # Use RS (Record Separator U+001E) as delimiter; tab is IFS-whitespace
  # and consecutive empty fields would collapse under POSIX read rules.
  _snap=$(jq -r '
    ([.project, (.tasks | length | tostring)] | join("\u001e")),
    (.tasks[] | [
      .id,
      .status,
      (.title // ""),
      (.pr_url // ""),
      (.claude_status // ""),
      (.worktree_mode // "worktree")
    ] | join("\u001e"))
  ' "$STATE_FILE" 2>/dev/null) || return 0

  local _first=true
  while IFS=$'\x1e' read -r _f1 _f2 _f3 _f4 _f5 _f6; do
    if $_first; then
      _project_name="$_f1"
      _task_count="$_f2"
      _first=false
      continue
    fi
    _task_status[$_f1]="$_f2"
    _task_title[$_f1]="$_f3"
    _task_pr[$_f1]="$_f4"
    _task_claude[$_f1]="$_f5"
    _task_wtmode[$_f1]="$_f6"
    case "$_f2" in
      pending|paused) _col0_ids+=("$_f1") ;;
      active)         _col1_ids+=("$_f1") ;;
      needs_review)   _col2_ids+=("$_f1") ;;
      review)         _col3_ids+=("$_f1") ;;
      done)           _col4_ids+=("$_f1") ;;
    esac
  done <<< "$_snap"
}

# O(1) task lookup by column and row index; sets _tid
_get_task_at() {
  local _col="$1" _row="$2"
  case $_col in
    0) _tid="${_col0_ids[$_row]:-}" ;;
    1) _tid="${_col1_ids[$_row]:-}" ;;
    2) _tid="${_col2_ids[$_row]:-}" ;;
    3) _tid="${_col3_ids[$_row]:-}" ;;
    4) _tid="${_col4_ids[$_row]:-}" ;;
    *) _tid="" ;;
  esac
}

# Get selected task ID for current cursor position; sets _tid, returns 1 if none
_get_selected_id() {
  _tid=""
  [[ ${col_counts[$cur_col]:-0} -gt 0 ]] || return 1
  _get_task_at "$cur_col" "${cur_row[$cur_col]}"
  [[ -n "$_tid" ]] || return 1
}

# Move cursor
move_to() { printf '\e[%d;%dH' "$1" "$2"; }

# Clear screen
cls() { printf '\e[2J\e[H'; }

# Hide/show cursor
cursor_hide() { printf '\e[?25l'; }
cursor_show() { printf '\e[?25h'; }

cmd_dash() {
  require_init
  ensure_tmux_session

  # If we're not in the cloard-board tmux, launch dashboard in it
  if [[ -z "${TMUX:-}" ]]; then
    # Ensure the dashboard window exists before respawning
    if ! tmux_window_exists "dashboard"; then
      tmux_cmd new-window -t "board" -n "dashboard" -c "$PWD"
    fi
    # Always (re)launch _dash_loop in the dashboard window to guarantee it's running
    # Pass PWD so the respawned process cd's to the project root (STATE_DIR is relative)
    # Quote both PWD and SCRIPT_PATH to handle spaces in paths
    local safe_pwd safe_script
    safe_pwd=${(q)${PWD}}
    safe_script=${(q)${SCRIPT_PATH}}
    tmux_cmd respawn-window -k -t "board:dashboard" "cd ${safe_pwd} && exec ${safe_script} _dash_loop"
    pin_dashboard_to_zero
    tmux_cmd attach -t "board:dashboard"
    return
  fi

  # If inside tmux but not in cloard-board socket, warn
  if [[ "${TMUX:-}" != *"${TMUX_SOCKET}"* ]]; then
    warn "you're in a different tmux; run outside tmux or inside cloard-board"
    return 1
  fi

  # Already inside cloard-board tmux; just switch to dashboard
  tmux_select_window "dashboard"
}

# The actual dashboard rendering loop (run inside tmux window)
cmd__dash_loop() {
  require_init
  set +x  # Disable any inherited trace mode (set -x) that would corrupt TUI output
  set +e  # Prevent unguarded commands from killing the TUI loop
  setopt TYPESET_SILENT 2>/dev/null  # Prevent zsh from printing variable values on re-declaration

  # Load zsh/datetime for optional CLOARD_DEBUG frame timing
  zmodload zsh/datetime 2>/dev/null || true

  # State: current column and row selection
  local cur_col=0
  local -a cur_row=(0 0 0 0 0)  # per-column cursor

  # Declare snapshot arrays (persist across loop iterations, modified by _snapshot_tasks via dynamic scope)
  typeset -A _task_status _task_title _task_pr _task_claude _task_wtmode
  local -a _col0_ids _col1_ids _col2_ids _col3_ids _col4_ids
  local _project_name="" _task_count=0
  local _tid=""  # scratch variable used by _get_task_at / _get_selected_id
  local -a col_counts=(0 0 0 0 0)  # column counts; declared at function scope for _get_selected_id visibility

  # Trap to restore terminal on exit
  cleanup_dash() {
    cursor_show
    stty echo 2>/dev/null
    printf '\033[?1049l'  # Leave alternate screen, restoring previous terminal content
  }
  trap cleanup_dash EXIT INT TERM

  printf '\033[?1049h'  # Enter alternate screen (clean slate, no contamination on exit)
  cursor_hide
  stty -echo 2>/dev/null

  # Drain any pending terminal responses (e.g. Ghostty DA1/DA2/DSR replies)
  # that would otherwise be misinterpreted as key presses by the input handler
  while read -rsk1 -t 0.05 _discard 2>/dev/null; do :; done

  while true; do
    # Optional debug timing
    local _t0=""
    [[ "${CLOARD_DEBUG:-}" == "1" ]] && _t0=${EPOCHREALTIME:-}

    # Terminal dimensions
    local cols=$(tput cols)
    local rows=$(tput lines)
    local col_width=$(( (cols - 2) / 5 ))
    local card_inner=$(( col_width - 4 ))

    # Snapshot all task data in a single jq call (replaces ~47 per-field jq calls)
    _snapshot_tasks

    # Compute column counts from cached arrays
    col_counts[0]=${#_col0_ids[@]}
    col_counts[1]=${#_col1_ids[@]}
    col_counts[2]=${#_col2_ids[@]}
    col_counts[3]=${#_col3_ids[@]}
    col_counts[4]=${#_col4_ids[@]}

    # Clamp cursors
    for i in {0..4}; do
      if [[ ${cur_row[$i]} -ge ${col_counts[$i]} ]] && [[ ${col_counts[$i]} -gt 0 ]]; then
        cur_row[$i]=$(( col_counts[$i] - 1 ))
      elif [[ ${col_counts[$i]} -eq 0 ]]; then
        cur_row[$i]=0
      fi
    done

    # Pre-compute border strings (subprocess-free via zsh loop)
    local _border_card="" _border_full="" _i
    for (( _i=0; _i<card_inner; _i++ )); do _border_card+="─"; done
    for (( _i=0; _i<cols; _i++ )); do _border_full+="─"; done

    # Begin frame buffer (single output at end eliminates tearing)
    local _frame=""

    # Title bar
    local title_str="  cloard-board | $_project_name | $_task_count tasks"
    _frame+=$(printf "${C_BOLD}${C_BG_BLUE}${C_WHITE}%-${cols}s${C_RESET}" "$title_str")
    _frame+=$'\n'

    # Column headers
    local header_line=""
    for i in {0..4}; do
      local cc=$(col_color "$i")
      local name="${COL_NAMES[$i]}"
      local cnt="${col_counts[$i]}"
      local selected=""
      [[ $i -eq $cur_col ]] && selected="${C_BOLD}"
      local hdr=$(printf "%s (%d)" "$name" "$cnt")
      hdr=$(trunc "$hdr" "$col_width")
      header_line+=$(printf "${selected}${cc}%-${col_width}s${C_RESET}" "$hdr")
    done
    _frame+="$header_line"$'\n'

    # Separator (pre-computed, no subprocess)
    _frame+="$_border_full"$'\n'

    # Render cards: iterate rows
    local max_cards=0
    for i in {0..4}; do
      [[ ${col_counts[$i]} -gt $max_cards ]] && max_cards=${col_counts[$i]}
    done

    # Card height: 5 lines (top border, id, title, status/pr, bottom border)
    local card_height=5
    local max_visible_rows=$(( (rows - 5) / card_height ))
    [[ $max_cards -gt $max_visible_rows ]] && max_cards=$max_visible_rows

    local _row_seq=()
    if [[ $max_cards -gt 0 ]]; then
      _row_seq=($(seq 0 $((max_cards - 1))))
    fi
    for row_idx in "${_row_seq[@]}"; do
      # For each card line (0=top border, 1=id, 2=title, 3=extra, 4=bottom border)
      for line in {0..4}; do
        local output=""
        for col_idx in {0..4}; do
          local cc=$(col_color "$col_idx")

          # O(1) task lookup via indexed array (replaces O(n) while-read scan)
          _get_task_at "$col_idx" "$row_idx"
          local task_id="$_tid"

          if [[ -z "$task_id" ]]; then
            # Empty cell
            output+=$(printf '%-*s' "$col_width" "")
          else
            # Override color for paused tasks in the pending column (cached lookup)
            if [[ $col_idx -eq 0 ]] && [[ "${_task_status[$task_id]}" == "paused" ]]; then
              cc="$C_CYAN"
            fi

            local is_selected=false
            [[ $col_idx -eq $cur_col && ${cur_row[$col_idx]} -eq $row_idx ]] && is_selected=true

            local title="${_task_title[$task_id]}"
            local pr="${_task_pr[$task_id]}"
            local pr_short=""
            [[ -n "$pr" ]] && pr_short=$(echo "$pr" | grep -oE '#[0-9]+' 2>/dev/null || echo "PR")

            local sel_prefix=" "
            local sel_color=""
            if $is_selected; then
              sel_prefix=">"
              sel_color="${C_BOLD}${C_BG_BLUE}${C_WHITE}"
            fi

            local cell=""
            case $line in
              0) # Top border (pre-computed border string)
                if $is_selected; then
                  cell=$(printf "${sel_color}${sel_prefix}┌%s┐${C_RESET}" "$_border_card")
                else
                  cell=$(printf "${cc} ┌%s┐${C_RESET}" "$_border_card")
                fi
                ;;
              1) # ID line
                local id_str=$(trunc "$task_id" $((card_inner - 1)))
                if $is_selected; then
                  cell=$(printf "${sel_color} │%-*s│${C_RESET}" "$card_inner" " ${id_str}")
                else
                  cell=$(printf "${cc} │${C_BOLD}%-*s${C_RESET}${cc}│${C_RESET}" "$card_inner" " ${id_str}")
                fi
                ;;
              2) # Title line
                local title_str=$(trunc "$title" $((card_inner - 1)))
                if $is_selected; then
                  cell=$(printf "${sel_color} │%-*s│${C_RESET}" "$card_inner" " ${title_str}")
                else
                  cell=$(printf "${cc} │%-*s│${C_RESET}" "$card_inner" " ${title_str}")
                fi
                ;;
              3) # Status/PR line (cached claude_status lookup)
                local cstatus="${_task_claude[$task_id]}"
                local extra=""
                local extra_color=""
                if [[ "$cstatus" == "working" ]]; then
                  extra="● working"
                  extra_color="${C_GREEN}"
                elif [[ "$cstatus" == "waiting" ]]; then
                  extra="○ waiting"
                  extra_color="${C_YELLOW}"
                fi
                if [[ -n "$pr_short" ]]; then
                  if [[ -n "$extra" ]]; then
                    extra="${extra} ${pr_short}"
                  else
                    extra="$pr_short"
                  fi
                fi
                extra=$(trunc "$extra" $((card_inner - 1)))
                if $is_selected; then
                  cell=$(printf "${sel_color} │%-*s│${C_RESET}" "$card_inner" " ${extra}")
                elif [[ -n "$extra_color" ]]; then
                  cell=$(printf "${cc} │${extra_color}%-*s${C_RESET}${cc}│${C_RESET}" "$card_inner" " ${extra}")
                else
                  cell=$(printf "${cc}${C_DIM} │%-*s│${C_RESET}" "$card_inner" " ${extra}")
                fi
                ;;
              4) # Bottom border (pre-computed border string)
                if $is_selected; then
                  cell=$(printf "${sel_color} └%s┘${C_RESET}" "$_border_card")
                else
                  cell=$(printf "${cc} └%s┘${C_RESET}" "$_border_card")
                fi
                ;;
            esac
            output+="$cell"
            # Pad to column width if needed
            local cell_visual_len=$((card_inner + 4))
            local pad=$(( col_width - cell_visual_len ))
            [[ $pad -gt 0 ]] && output+=$(printf '%*s' "$pad" "")
          fi
        done
        _frame+="$output"$'\n'
      done
    done

    # Output entire frame at once: cursor home + buffered frame + clear below
    printf '\033[H%s\033[J' "$_frame"

    # Footer with keybindings
    move_to "$((rows - 1))" 1
    printf "${C_DIM}  h/l: columns  j/k: tasks  Enter: open  </> move  s: shell  p: pause  o: new  x: done  d: diff  q: quit  (^b b: here)${C_RESET}"

    # Debug timing (CLOARD_DEBUG=1 logs frame render time)
    if [[ -n "${_t0:-}" ]] && [[ -n "${EPOCHREALTIME:-}" ]]; then
      local _elapsed=$(( (EPOCHREALTIME - _t0) * 1000 ))
      printf '%s frame: %.1fms\n' "$(date +%T)" "$_elapsed" >> /tmp/cloard-perf.log
    fi

    # Read key with timeout (non-blocking refresh)
    # NOTE: zsh uses -k (not -n) to read N chars without waiting for newline
    local key=""
    read -rsk1 -t "$DASH_REFRESH" key 2>/dev/null || true

    # Handle escape sequences (arrow keys)
    if [[ "$key" == $'\e' ]]; then
      local seq=""
      read -rsk2 -t 0.1 seq 2>/dev/null || true
      case "$seq" in
        '[A') key='k' ;;  # up
        '[B') key='j' ;;  # down
        '[C') key='l' ;;  # right
        '[D') key='h' ;;  # left
      esac
    fi

    case "$key" in
      h) # Left column
        [[ $cur_col -gt 0 ]] && cur_col=$((cur_col-1))
        ;;
      l) # Right column
        [[ $cur_col -lt 4 ]] && cur_col=$((cur_col+1))
        ;;
      j) # Down in column
        local max_idx=$(( col_counts[$cur_col] - 1 ))
        [[ ${cur_row[$cur_col]} -lt $max_idx ]] && cur_row[$cur_col]=$(( cur_row[$cur_col] + 1 ))
        ;;
      k) # Up in column
        [[ ${cur_row[$cur_col]} -gt 0 ]] && cur_row[$cur_col]=$(( cur_row[$cur_col] - 1 ))
        ;;
      '') ;; # Timeout/no input: just refresh the display
      $'\n'|$'\r') # Enter: open/interact with task based on status
        if _get_selected_id; then
          local sel_id="$_tid"
          local cur_status="${_task_status[$sel_id]}"
          case "$cur_status" in
            pending)
              # Start task: prompt for instructions so Claude begins working immediately
              cursor_show
              stty echo
              local task_title="${_task_title[$sel_id]}"
              echo ""
              echo "${C_CYAN}Starting task '${sel_id}': ${task_title}${C_RESET}"
              printf "${C_CYAN}Prompt for Claude (or Enter to skip): ${C_RESET}"
              local task_prompt=""
              read -r task_prompt
              # Ask about worktree mode (cached lookup)
              local dash_wt_mode="${_task_wtmode[$sel_id]}"
              if [[ "$dash_wt_mode" != "none" ]]; then
                printf "${C_CYAN}Use worktree? [Y/n]: ${C_RESET}"
                local wt_choice=""
                read -r wt_choice
                if [[ "$wt_choice" =~ ^[nN]$ ]]; then
                  dash_wt_mode="none"
                  update_task_field "$sel_id" "worktree_mode" "none"
                  update_task_field_raw "$sel_id" "branch" "null"
                fi
              fi
              stty -echo
              cursor_hide
              local wt_path_existing=$(find_worktree_path "$sel_id")
              if [[ -z "$wt_path_existing" ]]; then
                local safe_cwd
                safe_cwd=${(q)${PWD}}
                local dash_claude_cmd
                if [[ "$dash_wt_mode" == "none" ]]; then
                  dash_claude_cmd="claude --dangerously-skip-permissions"
                else
                  dash_claude_cmd="claude --worktree ${sel_id} --dangerously-skip-permissions"
                fi
                if [[ -n "$task_prompt" ]]; then
                  local escaped="${task_prompt//\'/\'\\\'\'}"
                  dash_claude_cmd="${dash_claude_cmd} '${escaped}'"
                fi
                tmux_create_window "$sel_id" "zsh" "-c" "export CLOARD_TASK_ID=${sel_id} CLOARD_BOARD_DIR=${safe_cwd} && cd ${safe_cwd} && ${dash_claude_cmd}; zsh; tmux -L cloard-board select-window -t board:dashboard 2>/dev/null"
              fi
              update_task_field "$sel_id" "status" "active"
              update_task_field "$sel_id" "started_at" "$(now_iso)"
              tmux_select_window "$sel_id"
              ;;
            paused)
              # Resume paused task (cached worktree_mode lookup)
              local wt_mode_paused="${_task_wtmode[$sel_id]}"
              if ! tmux_window_exists "$sel_id"; then
                if [[ "$wt_mode_paused" == "none" ]]; then
                  local safe_pwd_p
                  safe_pwd_p=${(q)${PWD}}
                  tmux_create_window "$sel_id" "zsh" "-c" "export CLOARD_TASK_ID=${sel_id} CLOARD_BOARD_DIR=${safe_pwd_p} && cd ${safe_pwd_p} && claude --continue --dangerously-skip-permissions; zsh; tmux -L cloard-board select-window -t board:dashboard 2>/dev/null"
                else
                  local wt_p=$(find_worktree_path "$sel_id")
                  if [[ -n "$wt_p" ]]; then
                    local safe_wt_p
                    safe_wt_p=${(q)${wt_p}}
                    local safe_board_dir_p=${(q)${PWD}}
                    tmux_create_window "$sel_id" "zsh" "-c" "export CLOARD_TASK_ID=${sel_id} CLOARD_BOARD_DIR=${safe_board_dir_p} && cd ${safe_wt_p} && claude --continue --dangerously-skip-permissions; zsh; tmux -L cloard-board select-window -t board:dashboard 2>/dev/null"
                  fi
                fi
              fi
              update_task_field "$sel_id" "status" "active"
              tmux_select_window "$sel_id"
              ;;
            active|needs_review|review)
              # Attach to task window, recreating it if needed
              if ! tmux_window_exists "$sel_id"; then
                local wt_mode_act="${_task_wtmode[$sel_id]}"
                if [[ "$wt_mode_act" == "none" ]]; then
                  local safe_pwd_a
                  safe_pwd_a=${(q)${PWD}}
                  tmux_create_window "$sel_id" "zsh" "-c" "export CLOARD_TASK_ID=${sel_id} CLOARD_BOARD_DIR=${safe_pwd_a} && cd ${safe_pwd_a} && claude --continue --dangerously-skip-permissions; zsh; tmux -L cloard-board select-window -t board:dashboard 2>/dev/null"
                else
                  local wt_a=$(find_worktree_path "$sel_id")
                  if [[ -n "$wt_a" ]]; then
                    local safe_wt_a safe_board_a
                    safe_wt_a=${(q)${wt_a}}
                    safe_board_a=${(q)${PWD}}
                    tmux_create_window "$sel_id" "zsh" "-c" "export CLOARD_TASK_ID=${sel_id} CLOARD_BOARD_DIR=${safe_board_a} && cd ${safe_wt_a} && claude --continue --dangerously-skip-permissions; zsh; tmux -L cloard-board select-window -t board:dashboard 2>/dev/null"
                  fi
                fi
              fi
              cursor_show
              tmux_select_window "$sel_id"
              cursor_hide
              ;;
            done) ;; # No-op
          esac
        fi
        ;;
      '>'|'.') # Move task one status to the right
        if _get_selected_id; then
          local sel_id="$_tid"
          local mv_status="${_task_status[$sel_id]}"
          local -a status_order=("pending" "paused" "active" "needs_review" "review" "done")
          local mv_idx=-1
          for (( i=0; i<${#status_order[@]}; i++ )); do
            [[ "${status_order[$i]}" == "$mv_status" ]] && mv_idx=$i
          done
          if [[ $mv_idx -ge 0 && $mv_idx -lt $((${#status_order[@]} - 1)) ]]; then
            local next_status="${status_order[$((mv_idx + 1))]}"
            if [[ "$mv_status" == "needs_review" && "$next_status" == "review" ]]; then
              # Trigger PR creation flow
              cursor_show
              stty echo
              echo ""
              echo "${C_YELLOW}Review '${sel_id}': this will push the branch and create a PR.${C_RESET}"
              printf "Proceed? [y/N] "
              local confirm=""
              read -r confirm
              if [[ "$confirm" =~ ^[yY]$ ]]; then
                (cmd_review "$sel_id") 2>&1 || true
              fi
              stty -echo
              cursor_hide
            elif [[ "$mv_status" == "review" && "$next_status" == "done" ]]; then
              # Trigger cleanup flow
              (cmd_done "$sel_id") 2>&1 || true
            else
              update_task_field "$sel_id" "status" "$next_status"
            fi
          fi
        fi
        ;;
      '<'|',') # Move task one status to the left
        if _get_selected_id; then
          local sel_id="$_tid"
          local mv_status="${_task_status[$sel_id]}"
          local -a status_order=("pending" "paused" "active" "needs_review" "review" "done")
          local mv_idx=-1
          for (( i=0; i<${#status_order[@]}; i++ )); do
            [[ "${status_order[$i]}" == "$mv_status" ]] && mv_idx=$i
          done
          if [[ $mv_idx -gt 0 ]]; then
            local prev_status="${status_order[$((mv_idx - 1))]}"
            update_task_field "$sel_id" "status" "$prev_status"
          fi
        fi
        ;;
      o) # Create new task
        cursor_show
        stty echo
        echo ""
        printf "${C_CYAN}Task ID: ${C_RESET}"
        local new_id=""
        read -r new_id
        if [[ -n "$new_id" ]]; then
          printf "${C_CYAN}Title: ${C_RESET}"
          local new_title=""
          read -r new_title
          if [[ -n "$new_title" ]]; then
            local add_output
            add_output=$( (cmd_add "$new_id" --title "$new_title") 2>&1 ) || true
            if [[ -n "$add_output" ]]; then
              echo "$add_output"
              sleep 1.5
            fi
          fi
        fi
        stty -echo
        cursor_hide
        ;;
      x) # Done/delete selected task
        if _get_selected_id; then
          local sel_id="$_tid"
          local sel_status="${_task_status[$sel_id]}"
          if [[ "$sel_status" == "done" ]]; then
            (cmd_rm "$sel_id") 2>&1 || true
          else
            (cmd_done "$sel_id") 2>&1 || true
          fi
        fi
        ;;
      d) # Show diff (cached worktree_mode lookup)
        if _get_selected_id; then
          local sel_id="$_tid"
          local diff_dir=""
          if [[ "${_task_wtmode[$sel_id]}" == "none" ]]; then
            diff_dir="$PWD"
          else
            diff_dir=$(find_worktree_path "$sel_id")
          fi
          if [[ -n "$diff_dir" ]]; then
            cursor_show
            stty echo
            (cd "$diff_dir" && git diff --stat && echo "" && git diff) | less
            stty -echo
            cursor_hide
          fi
        fi
        ;;
      s) # Shell popup: capture tmux pane output
        if _get_selected_id; then
          local sel_id="$_tid"
          if tmux_window_exists "$sel_id"; then
            cursor_show
            stty echo
            # Capture pane content with history
            local pane_content
            pane_content=$(tmux_cmd capture-pane -t "board:${sel_id}" -p -S -500 2>/dev/null || echo "(no output)")
            echo "$pane_content" | less -R +G
            stty -echo
            cursor_hide
          fi
        fi
        ;;
      p) # Pause active task
        if _get_selected_id; then
          local sel_id="$_tid"
          local p_status="${_task_status[$sel_id]}"
          if [[ "$p_status" == "active" || "$p_status" == "needs_review" ]]; then
            tmux_kill_window "$sel_id"
            update_task_field "$sel_id" "status" "paused"
            update_task_field_raw "$sel_id" "claude_status" "null"
          fi
        fi
        ;;
      q) # Quit / detach
        cursor_show
        tmux_cmd detach-client 2>/dev/null || exit 0
        exit 0
        ;;
    esac
  done
}

# ── Main dispatcher ────────────────────────────────────────────────────────────
main() {
  require_cmd jq
  require_cmd tmux
  require_cmd git

  # Anchor to repo root for consistent state file location regardless of CWD
  local _root
  _root=$(git rev-parse --show-toplevel 2>/dev/null) && cd "$_root" || true

  local cmd="${1:-help}"
  shift 2>/dev/null || true

  case "$cmd" in
    init)       cmd_init "$@" ;;
    add)        cmd_add "$@" ;;
    list|ls)    cmd_list "$@" ;;
    start)      cmd_start "$@" ;;
    go)         cmd_go "$@" ;;
    dash)       cmd_dash "$@" ;;
    attach)     cmd_attach "$@" ;;
    advance)    cmd_advance "$@" ;;
    review)     cmd_review "$@" ;;
    done)       cmd_done "$@" ;;
    pause)      cmd_pause "$@" ;;
    resume)     cmd_resume "$@" ;;
    rm|remove)  cmd_rm "$@" ;;
    status)     cmd_status "$@" ;;
    signal)     cmd_signal "$@" ;;
    doctor)     cmd_doctor "$@" ;;
    _dash_loop) cmd__dash_loop "$@" ;;
    help|-h|--help)    cmd_help ;;
    version|-v|--version) cmd_version ;;
    *)          die "unknown command: ${cmd}; run 'cloard-board help'" ;;
  esac
}

main "$@"
